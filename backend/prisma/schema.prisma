generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  RESELLER
  SUPPLIER
  DRIVER
  ADMIN
  DROPSHIPPER
}

enum KYCStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum OrderStatus {
  ORDERED
  CONFIRMED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  UPI
  CARD
  NETBANKING
  WALLET
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ── 1. User Profile (Firebase UID as PK) ───────────────────────

model Profile {
  id        String   @id // Firebase UID
  email     String?  @unique
  phone     String?  @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  role      UserRole @default(CUSTOMER)

  // Supplier & Auth Fields
  passwordHash    String?  @map("password_hash")
  storeName       String?  @map("store_name")
  gstin           String?
  pan             String?
  bankDetails     Json?    @map("bank_details")
  tier            String?  @default("Silver")
  tierLabel       String?  @default("Silver Supplier") @map("tier_label")
  rating          Float    @default(5.0)
  followers       String?  @default("0")
  experienceYears String?  @default("1+") @map("experience_years")

  addresses       Address[]
  orders          Order[]
  cart            CartItem[]
  wishlist        WishlistItem[]
  reviews         Review[]
  wallet          Wallet?
  kycApplications KYCApplication[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  referralsMade   Referral[]     @relation("Referrer")
  referralsUsed   Referral[]     @relation("Referred")
  deliveryTasks   DeliveryTask[]
  storeIntegrations StoreIntegration[]
  webhookLogs     WebhookLog[]
  marginConfig    DropshipperMarginConfig?

  // Soft Delete Fields
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  isActive  Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

// ── 2. Address ─────────────────────────────────────────────────

model Address {
  id          String  @id @default(uuid())
  userId      String  @map("user_id")
  user        Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String  @map("full_name")
  phone       String
  pincode     String
  addressLine String  @map("address_line")
  city        String
  state       String
  isDefault   Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("addresses")
}

// ── 3. Product Categories ──────────────────────────────────────

model Category {
  id            String     @id @default(uuid())
  name          String     @unique
  slug          String     @unique
  imageUrl      String?    @map("image_url")
  parentId      String?    @map("parent_id")
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories Category[] @relation("CategoryHierarchy")
  products      Product[]
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([parentId])
  @@map("categories")
}

// ── 4. Products ────────────────────────────────────────────────

model Product {
  id                 String   @id @default(uuid())
  title              String
  description        String?
  price              Float
  originalPrice      Float?   @map("original_price")
  discountPercentage Int      @default(0) @map("discount_percentage")
  rating             Float    @default(0)
  reviewsCount       Int      @default(0) @map("reviews_count")
  categorySlug       String   @map("category_slug")
  category           Category @relation(fields: [categorySlug], references: [slug])
  subCategory        String?  @map("sub_category")
  images             String[]
  sizes              String[] @default(["S", "M", "L", "XL", "Free Size"])
  colors             String[] @default([])
  stock              Int      @default(50)
  isFreeDelivery     Boolean  @default(true) @map("is_free_delivery")
  supplierName       String   @default("Verified Supplier") @map("supplier_name")

  supplierId         String?  @map("supplier_id")

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  orderItems    OrderItem[]

  // Soft Delete Fields
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  isActive  Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("products")
}

// ── 5. Cart Items ──────────────────────────────────────────────

model CartItem {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  user      Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  size      String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId, size])
  @@map("cart_items")
}

// ── 6. Wishlist Items ──────────────────────────────────────────

model WishlistItem {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  user      Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ── 7. Orders ──────────────────────────────────────────────────

model Order {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  user            Profile       @relation(fields: [userId], references: [id])
  items           OrderItem[]
  totalAmount     Float         @map("total_amount")
  shippingAddress Json          @map("shipping_address")
  paymentMethod   PaymentMethod @default(COD) @map("payment_method")
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  orderStatus     OrderStatus   @default(ORDERED) @map("order_status")
  deliveryTask    DeliveryTask?
  returnRequest   ReturnRequest?

  // Soft Delete Fields
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  isActive  Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("orders")
}

// ── 8. Order Items ─────────────────────────────────────────────

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  price     Float
  size      String?

  @@map("order_items")
}

// ── 9. Reviews ─────────────────────────────────────────────────

model Review {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  user      Profile @relation(fields: [userId], references: [id])
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  comment   String?
  images    String[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@map("reviews")
}

// ── 10. Wallet ─────────────────────────────────────────────────

model Wallet {
  id      String  @id @default(uuid())
  userId  String  @unique @map("user_id")
  user    Profile @relation(fields: [userId], references: [id])
  balance Float   @default(0)
  pending Float   @default(0)

  transactions WalletTransaction[]

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wallets")
}

// ── 11. Wallet Transactions ────────────────────────────────────

model WalletTransaction {
  id          String  @id @default(uuid())
  walletId    String  @map("wallet_id")
  wallet      Wallet  @relation(fields: [walletId], references: [id])
  amount      Float
  type        String  // credit | debit | reversed
  description String?
  orderId     String? @map("order_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("wallet_transactions")
}

// ── 12. KYC Applications ───────────────────────────────────────

model KYCApplication {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       Profile   @relation(fields: [userId], references: [id])
  type       String    // dropshipper | affiliate
  status     KYCStatus @default(PENDING)
  documents  Json
  adminNotes String?   @map("admin_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("kyc_applications")
}

// ── 13. Return Requests ────────────────────────────────────────

model ReturnRequest {
  id      String @id @default(uuid())
  orderId String @unique @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])
  reason  String
  status  String @default("requested") // requested | approved | picked_up | refunded | rejected
  images  String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("return_requests")
}

// ── 14. Notifications ──────────────────────────────────────────

model Notification {
  id     String  @id @default(uuid())
  userId String  @map("user_id")
  user   Profile @relation(fields: [userId], references: [id])
  title  String
  body   String
  type   String  // order | promo | system | earning
  isRead Boolean @default(false) @map("is_read")
  data   Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

// ── 15. Support Tickets ────────────────────────────────────────

model SupportTicket {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  user        Profile      @relation(fields: [userId], references: [id])
  subject     String
  description String
  category    String
  status      TicketStatus @default(OPEN)
  priority    String       @default("normal")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("support_tickets")
}

// ── 16. Delivery Tasks ─────────────────────────────────────────

model DeliveryTask {
  id           String    @id @default(uuid())
  orderId      String    @unique @map("order_id")
  order        Order     @relation(fields: [orderId], references: [id])
  driverId     String?   @map("driver_id")
  driver       Profile?  @relation(fields: [driverId], references: [id])
  status       String    @default("pending") // pending | assigned | picked_up | in_transit | delivered
  pickupTime   DateTime? @map("pickup_time")
  deliveryTime DateTime? @map("delivery_time")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("delivery_tasks")
}

// ── 17. Referrals ──────────────────────────────────────────────

model Referral {
  id           String  @id @default(uuid())
  referrerId   String  @map("referrer_id")
  referrer     Profile @relation("Referrer", fields: [referrerId], references: [id])
  referredId   String  @map("referred_id")
  referred     Profile @relation("Referred", fields: [referredId], references: [id])
  code         String
  rewardAmount Float   @default(0) @map("reward_amount")
  isRedeemed   Boolean @default(false) @map("is_redeemed")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("referrals")
}

// ── 18. Promotional Banners ────────────────────────────────────

model Banner {
  id           String   @id @default(uuid())
  title        String
  subtitle     String?
  imageUrl     String   @map("image_url")
  targetUrl    String   @default("/") @map("target_url")
  badgeText    String?  @default("MEGA SALE") @map("badge_text")
  badgeColor   String?  @default("bg-purple-600 text-white") @map("badge_color")
  displayOrder Int      @default(1) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  clicksCount  Int      @default(0) @map("clicks_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

// ── 18. Coupons & Promotions ──────────────────────────────────

model Coupon {
  id          String    @id @default(uuid())
  code        String    @unique
  title       String
  description String?
  type        String    @default("FLAT") // 'FLAT' | 'PERCENT'
  value       Float
  minOrder    Float     @default(0) @map("min_order")
  maxDiscount Float?    @map("max_discount")
  expiresAt   DateTime  @map("expires_at")
  usageLimit  Int?      @map("usage_limit")
  usedCount   Int       @default(0) @map("used_count")
  isActive    Boolean   @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("coupons")
}

// ── 19. Dropshipper Store Integrations ─────────────────────────

model StoreIntegration {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  user             Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform         String   // SHOPIFY | WOOCOMMERCE | CUSTOM
  storeDomain      String?  @map("store_domain")
  accessToken      String?  @map("access_token")
  webhookSecret    String?  @map("webhook_secret")
  isConnected      Boolean  @default(false) @map("is_connected")
  autoSyncOrders   Boolean  @default(true) @map("auto_sync_orders")
  autoPushTracking Boolean  @default(true) @map("auto_push_tracking")
  inventorySync    Boolean  @default(true) @map("inventory_sync")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, platform])
  @@map("store_integrations")
}

// ── 20. Webhook Traffic Logs ───────────────────────────────────

model WebhookLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    String   // Shopify Store | WooCommerce | Inbound Webhook
  event      String   // orders/create | inventory/stock_update | fulfillments/update
  status     Int      @default(200)
  statusText String   @default("OK") @map("status_text")
  latency    String   // e.g. 118ms
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("webhook_logs")
}

// ── 21. Dropshipper Margin & Markup Configuration ───────────────

model DropshipperMarginConfig {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  user                 Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  pricingStrategy      String   @default("FIXED") @map("pricing_strategy") // 'FIXED' | 'PERCENTAGE'
  fixedMarkup          Float    @default(200) @map("fixed_markup")
  percentageMarkup     Float    @default(25) @map("percentage_markup")
  smartRounding        Boolean  @default(true) @map("smart_rounding")
  shippingMode         String   @default("FREE_TO_CUSTOMER") @map("shipping_mode") // 'FREE_TO_CUSTOMER' | 'SEPARATE'
  estimatedShippingFee Float    @default(60) @map("estimated_shipping_fee")
  categoryRules        Json?    @map("category_rules")

  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("dropshipper_margin_configs")
}

// ── 22. CMS Pages & Legal Policies (From Master) ────────────────

enum PageStatus {
  PUBLISHED
  DRAFT
}

model CmsPage {
  id              String     @id @default(uuid())
  title           String
  slug            String     @unique
  content         String     @db.Text
  status          PageStatus @default(PUBLISHED)
  metaTitle       String?    @map("meta_title")
  metaDescription String?    @map("meta_description")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@map("cms_pages")
}
}
