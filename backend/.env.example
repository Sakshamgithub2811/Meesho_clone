DIRECT_URL="postgresql://postgres:postgres@localhost:5432/meesho_db?schema=public"

# Supabase API (For Storage & Public API access)
SUPABASE_URL=https://acwpkfwqkktjuezwbxkt.supabase.co
SUPABASE_ANON_KEY=sb_publishable_2c9nhS78paiZ5oVKiewAcg_eoBDXQqo
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==================================================
# 2. AUTHENTICATION & SECURITY
# ==================================================
